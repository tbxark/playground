# Server environment for the optional shared-server feature (the Hono API in
# functions/ and the Go server in server/; both read the same names).
# Copy to `.env.local` for local dev (vite dev/preview middleware reads it)
# or configure the same names as Cloudflare secrets (`wrangler secret put`)
# / Vercel env vars / Docker `--env-file` in production. Never commit real values.
#
# The Go server additionally accepts HOST/PORT (default 127.0.0.1:8080) and
# ENV_FILE (path to a dotenv file); see server/README.md.

# --- Login (required to enable login; all three must be set) ---
# Single shared account. Comparison is constant-time; rate limited per IP.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# HS256 signing secret for login JWTs — use a long random string.
JWT_SECRET=please-generate-a-long-random-secret
# Optional: token lifetime in hours (default 168 = 7 days).
# JWT_TTL_HOURS=168

# Go server only: trust X-Forwarded-For / CF-Connecting-IP for login throttling.
# Enable only behind a trusted proxy that overwrites these headers with the real
# client IP; otherwise clients can spoof the limiter key. Default: false.
# TRUST_PROXY_HEADERS=true

# --- Upstreams (OpenAI-compatible; the base URL must include its version
# segment, e.g. https://gateway.example.com/v1) ---
# IMAGE_* falls back to LLM_* when unset, so a single gateway serving both
# only needs the LLM_* pair.
LLM_BASE_URL=https://gateway.example.com/v1
LLM_API_KEY=sk-...

# IMAGE_BASE_URL=https://gateway.example.com/v1
# IMAGE_API_KEY=sk-...

# --- Optional: model ids auto-enabled for a user after login when they have
# no enabled models yet (comma-separated). The client merges them from
# GET /api/health. ---
# SERVER_DEFAULT_MODELS=flux-1-dev,qwen-image-3.0

# --- Build flag (client side) ---
# VITE_SERVER_MODE=optional   # "off" (default) = pure frontend build
