{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiimage-playground",
  "compatibility_date": "2026-10-29",
  "main": "functions/adapters/worker.ts",
  // Vite's dist/ is served by the assets binding; the Worker only handles
  // /api/* (run_worker_first is required because not_found_handling below
  // would otherwise answer GET /api/* with index.html). Secrets (auth
  // credentials, JWT secret, upstream keys) go through `wrangler secret put`.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
